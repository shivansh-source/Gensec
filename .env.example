# Copy this file to .env and fill in real values — GenSec loads .env
# automatically at startup. Never commit your actual .env (it's already
# in .gitignore).

# Required for scanning (LLM triage) and generating fixes.
GROQ_API_KEY=gsk_...

# Required only for the `pr` / `scan-and-fix` step. GITHUB_TOKEN needs
# push access to GITHUB_REPO (classic PAT with the `repo` scope, or a
# fine-grained PAT with Contents: Read & write + Pull requests: Read & write).
GITHUB_TOKEN=ghp_...
GITHUB_USER=your-github-username
GITHUB_REPO=owner/repo-name

# free | pro | enterprise — see README Configuration section.
USER_PLAN=pro
